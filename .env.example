# DrawReport secrets — copy to .env and fill in. NEVER commit .env.
# The app runs with all of these empty (stubs/placeholders); fill them to go live.

# --- LLM (report generation) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=

# Alternate provider: set LLM_PROVIDER=gemini and LLM_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GOOGLE_GEMINI_BASE_URL=

# --- Admin panel (/admin). Empty = admin disabled (404). ---
ADMIN_PASS=
ADMIN_ALERT_EMAIL=spashap@gmail.com

# --- Google Analytics 4. Empty = no GA snippet. e.g. G-XXXXXXXXXX ---
GA_MEASUREMENT_ID=

# --- Search console ownership verification (meta tags). Token only, not the
#     whole tag. Empty = no tag. Google: prefer DNS TXT on the domain property
#     if you have registrar access; this is the URL-prefix fallback.
#     Bing: not needed if you import the site from Search Console. ---
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- sitemap.xml <lastmod> for undated pages (home, /report, legal, samples).
#     Blog posts date themselves from their frontmatter. Bump when copy changes. ---
SITEMAP_LASTMOD=2026-08-18

# --- IndexNow key (Bing/Yandex/Seznam). Public by design: it is served back at
#     /<key>.txt as proof of ownership. Empty = the route is not registered. ---
INDEXNOW_KEY=

# --- Payment: 'stub' until PayPal creds are provided, then 'paypal' ---
PAYMENT_BACKEND=stub
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Email: 'outbox' (writes HTML files in data/outbox) until Resend is set ---
MAIL_BACKEND=outbox
RESEND_API_KEY=
MAIL_FROM_EMAIL=hello@drawreport.com
MAIL_FROM_NAME=DrawReport

# --- i18n (comma-separated active locales) ---
LOCALES=en
DEFAULT_LOCALE=en

# --- Site ---
SITE_DOMAIN=drawreport.com
PUBLIC_BASE_URL=http://localhost:5000
